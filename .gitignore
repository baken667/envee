# Binaries
/bin/
/dist/
/envee
/enveed
/envee-*

# Test artifacts
*.test
*.out
coverage.*
*.coverprofile
# NOT a bare *.html: that silently swallowed site/index.html, so the landing
# page was never committed and Pages served a 404 while every check passed.
# `coverage.*` above already covers `go tool cover -html` output.
/coverage/

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Local config
envee.local.toml
envee.local.*.toml
.env
.env.local

# But the .env files inside examples/ are part of the example data
# (they get loaded by the _.file directive in envee.toml) and must be
# tracked. The lines below un-ignore exactly those.
!examples/**/*.env
!examples/**/*.env.local

# Research / planning artifacts (cloned sources we analyzed)
_research/

# Go
vendor/
glide.iml

# Generated docs (produced by ./cmd/gen-docs, emitted at release time by a
# goreleaser before-hook -- not committed).
/completions/
/manpages/

# Goreleaser
.goreleaser.yml.local
Untitled

# Zig
/zig-out/
/.zig-cache/
